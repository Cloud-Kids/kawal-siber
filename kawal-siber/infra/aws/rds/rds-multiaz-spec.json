{
  "DBInstanceIdentifier": "kawal-siber-prod-db",
  "Engine": "postgres",
  "EngineVersion": "16.4",
  "DBInstanceClass": "db.m6g.xlarge",
  "MultiAZ": true,
  "AllocatedStorage": 200,
  "MaxAllocatedStorage": 1000,
  "StorageType": "gp3",
  "Iops": 3000,
  "Throughput": 125,
  "StorageEncrypted": true,
  "KmsKeyId": "arn:aws:kms:ap-southeast-1:123456789012:key/12345678-1234-1234-1234-123456789abc",
  "PubliclyAccessible": false,
  "DBSubnetGroupName": "kawal-siber-db-subnet-group",
  "VpcSecurityGroupIds": [
    "sg-0123456789database"
  ],
  "DBParameterGroupName": "kawal-siber-postgres16-params",
  "BackupRetentionPeriod": 30,
  "PreferredBackupWindow": "18:00-19:00",
  "PreferredMaintenanceWindow": "sun:19:30-sun:20:30",
  "AutoMinorVersionUpgrade": false,
  "DeletionProtection": true,
  "Parameters": {
    "shared_buffers": "{DBInstanceClassMemory/4}",
    "work_mem": "16384",
    "maintenance_work_mem": "262144",
    "max_connections": "200",
    "rds.force_ssl": "1"
  }
}
