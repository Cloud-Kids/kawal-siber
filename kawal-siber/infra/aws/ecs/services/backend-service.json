{
  "serviceName": "kawal-siber-backend-service",
  "cluster": "kawal-siber-prod",
  "taskDefinition": "kawal-siber-backend",
  "desiredCount": 2,
  "launchType": "EC2",
  "deploymentConfiguration": {
    "minimumHealthyPercent": 100,
    "maximumPercent": 200,
    "deploymentCircuitBreaker": {
      "enable": true,
      "rollback": true
    }
  },
  "healthCheckGracePeriodSeconds": 60,
  "placementStrategies": [
    {
      "type": "spread",
      "field": "attribute:ecs.availability-zone"
    },
    {
      "type": "spread",
      "field": "instanceId"
    }
  ],
  "placementConstraints": [
    {
      "type": "distinctInstance"
    }
  ],
  "loadBalancers": [
    {
      "targetGroupArn": "arn:aws:elasticloadbalancing:ap-southeast-1:123456789012:targetgroup/tg-kawal-backend/1234567890abcdef",
      "containerName": "backend",
      "containerPort": 8000
    }
  ],
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": [
        "subnet-0aaa1111private1a",
        "subnet-0bbb2222private1b"
      ],
      "securityGroups": [
        "sg-0123456789backend"
      ],
      "assignPublicIp": "DISABLED"
    }
  }
}
