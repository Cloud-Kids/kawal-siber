{
  "serviceName": "kawal-siber-tools-agent-service",
  "cluster": "kawal-siber-prod",
  "taskDefinition": "kawal-siber-tools-agent",
  "desiredCount": 2,
  "launchType": "EC2",
  "deploymentConfiguration": {
    "minimumHealthyPercent": 100,
    "maximumPercent": 200,
    "deploymentCircuitBreaker": {
      "enable": true,
      "rollback": true
    }
  },
  "placementStrategies": [
    {
      "type": "spread",
      "field": "attribute:ecs.availability-zone"
    },
    {
      "type": "spread",
      "field": "instanceId"
    }
  ],
  "placementConstraints": [
    {
      "type": "distinctInstance"
    }
  ],
  "serviceRegistries": [
    {
      "registryArn": "arn:aws:servicediscovery:ap-southeast-1:123456789012:service/srv-toolsagent",
      "containerName": "tools-agent",
      "containerPort": 9000
    }
  ],
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": [
        "subnet-0aaa1111private1a",
        "subnet-0bbb2222private1b"
      ],
      "securityGroups": [
        "sg-0123456789tools"
      ],
      "assignPublicIp": "DISABLED"
    }
  }
}
