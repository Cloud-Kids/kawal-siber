{
  "family": "kawal-siber-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["EC2"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::123456789012:role/kawal-siber-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::123456789012:role/kawal-siber-worker-task-role",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/kawal-siber-worker:latest",
      "essential": true,
      "environment": [
        { "name": "PYTHONUNBUFFERED", "value": "1" },
        { "name": "SCAN_ENABLED", "value": "true" },
        { "name": "NMAP_TIMEOUT_SECONDS", "value": "120" },
        { "name": "POLL_INTERVAL_SECONDS", "value": "2.0" },
        { "name": "STALE_JOB_TIMEOUT_MINUTES", "value": "10" },
        { "name": "DB_POOL_SIZE", "value": "10" },
        { "name": "DB_MAX_OVERFLOW", "value": "5" },
        { "name": "TOOLS_AGENT_URL", "value": "http://tools.kawal-siber.internal:9000" },
        { "name": "S3_BUCKET_NAME", "value": "kawal-siber-evidence-prod-123456789012" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:kawal-siber/prod/database-url"
        },
        {
          "name": "TOOLS_AGENT_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:kawal-siber/prod/tools-agent-key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/kawal-siber-prod/worker",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "worker"
        }
      },
      "healthCheck": {
        "command": [
          "CMD",
          "python",
          "-c",
          "import sys, time, os; t=os.path.getmtime('/tmp/worker_heartbeat') if os.path.exists('/tmp/worker_heartbeat') else 0; sys.exit(0 if (time.time() - t) < 30 else 1)"
        ],
        "interval": 20,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      }
    }
  ]
}
