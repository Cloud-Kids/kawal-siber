# ==============================================================================
# KAWAL SIBER — AWS Distributed Deployment Environment Template
# ==============================================================================

# Global Project Info
PROJECT_NAME=kawal-siber
ENVIRONMENT=production
AWS_DEFAULT_REGION=ap-southeast-1

# Database Configuration (ks-db-01)
POSTGRES_DB=kawal_siber
POSTGRES_USER=kawal_user
POSTGRES_PASSWORD=CHANGE_ME_IN_SECRETS_MANAGER_DB_PASS
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=CHANGE_ME_IN_SECRETS_MANAGER_REP_PASS
DATABASE_URL=postgresql://kawal_user:CHANGE_ME_IN_SECRETS_MANAGER_DB_PASS@ks-db-01:5432/kawal_siber

# Backend API Configuration (ks-backend-01)
BACKEND_IMAGE=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/kawal-siber-backend:latest
SECRET_KEY=CHANGE_ME_IN_SECRETS_MANAGER_JWT_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
FRONTEND_URL=http://ks-lb-01

# Worker Pool Configuration (ks-worker-01)
WORKER_IMAGE=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/kawal-siber-worker:latest
SCAN_ENABLED=true
NMAP_TIMEOUT_SECONDS=120
POLL_INTERVAL_SECONDS=2.0
STALE_JOB_TIMEOUT_MINUTES=10

# Security Tools Agent Configuration (ks-tools-01)
TOOLS_AGENT_IMAGE=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/kawal-siber-tools-agent:latest
TOOLS_AGENT_KEY=CHANGE_ME_IN_SECRETS_MANAGER_TOOLS_KEY
TOOLS_AGENT_URL=http://ks-tools-01:9001
MAX_CONCURRENT_SCANS=4

# Frontend Configuration (ks-frontend-01)
FRONTEND_IMAGE=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/kawal-siber-frontend:latest
API_INTERNAL_URL=http://ks-lb-01:80
NEXT_PUBLIC_API_URL=/api/v1
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Storage & S3 Evidence Bucket (ks-backend-01 / ks-worker-01)
S3_BUCKET_NAME=kawal-siber-evidence-prod-123456789012
S3_REPORTS_PREFIX=reports/
S3_SCANS_PREFIX=scans/
S3_EVIDENCE_PREFIX=evidence/

