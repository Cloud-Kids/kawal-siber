# KAWAL SIBER — Docker Deployment Configuration (Phase 7 / Production)
# Used when running via Docker Compose stack

DATABASE_URL=sqlite:////data/kawal_siber.db
FRONTEND_URL=http://localhost:3000
API_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_API_URL=/api/v1
SCAN_ENABLED=false
NMAP_TIMEOUT_SECONDS=60
POLL_INTERVAL_SECONDS=3.0
MAX_XML_BYTES=1048576
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PYTHONUNBUFFERED=1

