# ------------------------------------------------------------------------------
# PostgreSQL 16 Standby Configuration — KAWAL SIBER (ks-db-01)
# ------------------------------------------------------------------------------
listen_addresses = '*'
port = 5432
max_connections = 200

# Memory Tuning (Identical to Primary)
shared_buffers = 1024MB
effective_cache_size = 3072MB
work_mem = 16MB
maintenance_work_mem = 256MB

# Standby Mode Settings
hot_standby = on
max_standby_archive_delay = 30s
max_standby_streaming_delay = 30s
wal_receiver_status_interval = 2s
hot_standby_feedback = on

# WAL Retrieval from Shared Archive if network stream lags
restore_command = 'cp /var/lib/postgresql/wal_archive/%f %p'

# Logging & Monitoring
logging_collector = on
log_directory = 'log'
log_filename = 'postgresql-standby-%Y-%m-%d_%H%M%S.log'
log_min_messages = warning
log_line_prefix = '%m [%p] %q%u@%d '

