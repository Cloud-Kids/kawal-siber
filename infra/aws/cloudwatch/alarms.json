{
  "Alarms": [
    {
      "AlarmName": "kawal-siber-backend-5xx-high",
      "MetricName": "HTTPCode_Target_5XX_Count",
      "Namespace": "AWS/ApplicationELB",
      "Statistic": "Sum",
      "Period": 60,
      "EvaluationPeriods": 3,
      "Threshold": 5,
      "ComparisonOperator": "GreaterThanOrEqualToThreshold",
      "Dimensions": [
        { "Name": "TargetGroup", "Value": "targetgroup/tg-kawal-backend/1234567890abcdef" },
        { "Name": "LoadBalancer", "Value": "app/kawal-siber-alb/1234567890abcdef" }
      ],
      "AlarmActions": ["arn:aws:sns:ap-southeast-1:123456789012:kawal-siber-security-alerts"]
    },
    {
      "AlarmName": "kawal-siber-ecs-deployment-circuit-breaker-fired",
      "MetricName": "DeploymentCircuitBreakerTriggered",
      "Namespace": "ECS/DeploymentMetrics",
      "Statistic": "Maximum",
      "Period": 60,
      "EvaluationPeriods": 1,
      "Threshold": 1,
      "ComparisonOperator": "GreaterThanOrEqualToThreshold",
      "Dimensions": [
        { "Name": "ClusterName", "Value": "kawal-siber-prod" }
      ],
      "AlarmActions": ["arn:aws:sns:ap-southeast-1:123456789012:kawal-siber-security-alerts"]
    },
    {
      "AlarmName": "kawal-siber-worker-queue-stalled",
      "MetricName": "OldestPendingJobAgeSeconds",
      "Namespace": "KAWALSiber/WorkerMetrics",
      "Statistic": "Maximum",
      "Period": 300,
      "EvaluationPeriods": 2,
      "Threshold": 300,
      "ComparisonOperator": "GreaterThanOrEqualToThreshold",
      "AlarmActions": ["arn:aws:sns:ap-southeast-1:123456789012:kawal-siber-security-alerts"]
    },
    {
      "AlarmName": "kawal-siber-rds-cpu-high",
      "MetricName": "CPUUtilization",
      "Namespace": "AWS/RDS",
      "Statistic": "Average",
      "Period": 300,
      "EvaluationPeriods": 2,
      "Threshold": 80,
      "ComparisonOperator": "GreaterThanOrEqualToThreshold",
      "Dimensions": [
        { "Name": "DBInstanceIdentifier", "Value": "kawal-siber-prod-db" }
      ],
      "AlarmActions": ["arn:aws:sns:ap-southeast-1:123456789012:kawal-siber-security-alerts"]
    }
  ]
}

