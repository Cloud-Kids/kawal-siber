{
  "family": "kawal-siber-tools-agent",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["EC2"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::123456789012:role/kawal-siber-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::123456789012:role/kawal-siber-tools-task-role",
  "containerDefinitions": [
    {
      "name": "tools-agent",
      "image": "123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/kawal-siber-tools-agent:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 9000,
          "hostPort": 9000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "9000" },
        { "name": "MAX_CONCURRENT_SCANS", "value": "4" },
        { "name": "PYTHONUNBUFFERED", "value": "1" }
      ],
      "secrets": [
        {
          "name": "TOOLS_AGENT_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:kawal-siber/prod/tools-agent-key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/kawal-siber-prod/tools-agent",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "tools-agent"
        }
      },
      "healthCheck": {
        "command": [
          "CMD",
          "curl",
          "-s",
          "-f",
          "http://127.0.0.1:9000/health"
        ],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      }
    }
  ]
}

