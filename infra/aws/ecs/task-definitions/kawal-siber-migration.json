{
  "family": "kawal-siber-migration",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["EC2"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::123456789012:role/kawal-siber-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::123456789012:role/kawal-siber-migration-task-role",
  "containerDefinitions": [
    {
      "name": "migration-runner",
      "image": "123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/kawal-siber-backend:latest",
      "essential": true,
      "command": ["alembic", "upgrade", "head"],
      "environment": [
        { "name": "PYTHONUNBUFFERED", "value": "1" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:kawal-siber/prod/database-url"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/kawal-siber-prod/migrations",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "migration"
        }
      }
    }
  ]
}

