{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3StorageAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::kawal-siber-evidence-prod-123456789012",
        "arn:aws:s3:::kawal-siber-evidence-prod-123456789012/*"
      ]
    },
    {
      "Sid": "KMSCustomerKeyAccess",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:ap-southeast-1:123456789012:key/12345678-1234-1234-1234-123456789abc"
    }
  ]
}

