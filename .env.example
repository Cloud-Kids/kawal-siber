# KAWAL SIBER — Environment Configuration
# Strategy: LOCALHOST-FIRST DEVELOPMENT, DOCKER-LATER DEPLOYMENT

# ─────────────────────────────────────────────────────────────
# 1. LOCALHOST DEVELOPMENT (Default)
# ─────────────────────────────────────────────────────────────

# SQLite database path (defaults to local storage/kawal_siber.db if unset)
DATABASE_URL=sqlite:///./storage/kawal_siber.db

# Allowed CORS origin for FastAPI backend
FRONTEND_URL=http://localhost:3000

# Next.js Server Components backend endpoint
API_INTERNAL_URL=http://127.0.0.1:8000

# Security Worker Safety Switch: set to true to process scan jobs
SCAN_ENABLED=false

# Subprocess timeout in seconds for an individual port scan
NMAP_TIMEOUT_SECONDS=60

# Background queue polling interval
POLL_INTERVAL_SECONDS=3.0

# Optional custom path to Nmap binary (auto-discovered on Windows/Linux if omitted)
# NMAP_PATH="C:\Program Files (x86)\Nmap\nmap.exe"

# Maximum accepted Nmap XML payload size in bytes (worker safety limit)
# MAX_XML_BYTES=1048576

# Browser-facing API base URL for the Next.js client (defaults to same-origin /api proxy)
# NEXT_PUBLIC_API_URL=

# ─────────────────────────────────────────────────────────────
# 2. DOCKER DEPLOYMENT OVERRIDES (Fase 7 / Production)
# Uncomment or use in compose.yaml when running within Docker stack
# ─────────────────────────────────────────────────────────────

# DATABASE_URL=sqlite:////data/kawal_siber.db
# API_INTERNAL_URL=http://backend:8000
# NODE_ENV=production
# NEXT_TELEMETRY_DISABLED=1
# PYTHONUNBUFFERED=1
